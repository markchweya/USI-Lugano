<div class="state">
  <p class="eyebrow">{{t "page.notMirrored"}}</p>
  <h1 class="state__title" tabindex="-1">{{t "page.missingTitle"}}</h1>
  <p class="state__lede">{{t "page.missingLede"}}</p>
  <p class="state__actions">
    <a class="button button--signal" href="{{original}}" rel="noopener">{{t "page.openOriginal"}} {{icon "external" 16}}</a>
    <a class="button button--ghost" href="{{search}}">{{icon "search" 18}} {{t "page.searchInstead"}}</a>
  </p>
</div>
