<div class="state state--lake">
  <p class="eyebrow">404</p>
  <h1 class="state__title" tabindex="-1">{{t "notFound.heading"}}</h1>
  <p class="state__lede">{{t "notFound.lede"}}</p>
  <p class="state__actions">
    <button type="button" class="button button--signal js-search-open">{{icon "search" 18}} {{t "notFound.search"}}</button>
    <a class="button button--ghost" href="{{home}}">{{t "notFound.home"}}</a>
  </p>
</div>
