pCaSTi","alt":"orientamento-1","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-9.jpg?itok=SSwaGQ37","alt":"orientamento-9","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-12.jpg?itok=gPomQrer","alt":"orientamento-12","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-mt_2.png?itok=OWfvJR9z","alt":"orientamento-mt_2","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-13.jpg?itok=v8kNFfS_","alt":"orientamento-13","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-14.jpg?itok=jfHNtf8i","alt":"orientamento-14","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-16.jpg?itok=IHhta1nn","alt":"orientamento-16","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-18.jpg?itok=DlZVMp8z","alt":"orientamento-18","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-19.jpg?itok=r8pNzwwt","alt":"orientamento-19","caption":""},{"kind":"image","src":"https://www.usi.ch/sites/default/files/styles/usi_large/public/storage/images/orientamento-mt-2026-ok.jpg?itok=2LElQ4M5","alt":"orientamento-mt-2026-ok","caption":""}]},{"t":"html","html":"<p>Our USI Master in International Tourism students come from more than 60 countries around the world, different academic fields, and many undergraduate universities. The diverse backgrounds of our students enhance the richness of the Master’s experience, while representing a real-life work environment in which you train your intercultural communication and soft skills in applied team projects every day, enabling a high-level career in the extremely globalized tourism sector.</p> <p>In 2003 the Master in International Tourism (MT) kicked off with eight students. By now, 450+ students have participated in our Master programme, hailing from the countries visibile in the globe here below.</p>"},{"t":"accordion","items":[{"title":"Study background","html":"<p>Undergraduate degrees obtained by our USI Master in International Tourism students, among others:</p> <ul> <li>Tourism</li> <li>Management and Economics</li> <li>Social Sciences</li> <li>Languages</li> <li>Communication</li> <li>Political Sciences / International Relations</li> <li>Hospitality</li> <li>Geography</li> <li>History</li> <li>Philosophy</li> <li>Biology</li> <li>Psychology</li> <li>Law</li> </ul>"}]}],"ctas":[{"label":"Apply Now","href":"/en/education-application"},{"label":"Contact us","href":"mailto:mt@usi.ch?subject=BTN Learn More"}],"nav":[{"label":"Overview","href":"/en/education/master/international-tourism"},{"label":"Our students","href":"/en/education/master/international-tourism/our-students"},{"label":"Why study tourism?","href":"/en/education/master/international-tourism/why-tourism"},{"label":"Why study tourism at USI?","href":"/en/education/master/international-tourism/why-tourism-at-usi"},{"label":"Academic and industry collaborations","href":"/en/education/master/international-tourism/academics-industry-collaborations"},{"label":"Study plan","href":"/en/education/master/international-tourism/structure-and-contents"},{"label":"Double Degree (optional)","href":"/en/education/master/international-tourism/structure-and-contents/optional-double-degree"},{"label":"Employability","href":"/en/education/master/international-tourism/career-prospects"},{"label":"Job Profiles","href":"/en/education/master/international-tourism/career-prospects/job-profiles"},{"label":"Employers","href":"/en/education/master/international-tourism/career-prosp