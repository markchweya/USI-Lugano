<a href=\"/en/originalnode/21584\">PubliBike bike sharing service</a>.</li> <li>Fact sheets (currently in Italian only): <a href=\"https://content.usi.ch/sites/default/files/storage/attachments/qualita/qualita-scheda_tematica_sosta_-_temperatura_stabili.pdf\">Temperature of the buildings</a>, <a href=\"https://content.usi.ch/sites/default/files/storage/attachments/qualita/qualita-001_scheda_tematica_sosta_-_impatto_asciugamani.pdf\">Environmental impact of hand dryers</a>, <a href=\"https://content.usi.ch/sites/default/files/storage/attachments/qualita/qualita-003_scheda_tematica_sosta_carta.pdf\">Paper</a>.</li> </ul>"}],"ctas":[],"nav":[{"label":"Sustainability","href":"/en/university/what-we-do/sustainability"},{"label":"Education","href":"/en/university/what-we-do/sustainability/education"},{"label":"Research","href":"/en/university/what-we-do/sustainability/research"},{"label":"Sustainability Award","href":"/en/node/34037"},{"label":"Overview","href":"/en/university/what-we-do/sustainability/sosta"},{"label":"Mobility","href":"/en/university/what-we-do/sustainability/sosta/mobility"},{"label":"Sustainability","href":"/en/university/what-we-do/sustainability/sosta/sustainability"},{"label":"Sustainable Development Goals","href":"/en/university/what-we-do/sustainability/sosta/sustainable-development-goals"},{"label":"Events","href":"/en/university/what-we-do/sustainability/events"},{"label":"News","href":"/en/university/what-we-do/sustainability/news"},{"label":"Report","href":"/en/university/what-we-do/sustainability/report"},{"label":"Thesis","href":"/en/university/what-we-do/sustainability/thesis"},{"label":"Sustainable travel","href":"/en/university/what-we-do/sustainability/sustainable-travel"}],"links":[{"label":"+41 58 666 4199","href":"tel:+41586664199"},{"label":"sosta@usi.ch","href":"mailto:sosta@usi.ch"},{"label":"Environment. Pocket Statistics 2023","href":"https://www.bfs.admin.ch/bfs/en/home/statistics/catalogues-databases/publications.assetdetail.2