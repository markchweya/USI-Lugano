</ul> <p><strong>USI Alumni Placement Survey 2004 (2.)</strong></p> <ul> <li><a href=\"https://content.usi.ch/sites/default/files/storage/attachments/alumni/alumni-sintesi-risultati-2004.pdf\">Ergebnisse 2004</a></li> </ul> <p><strong>USI Alumni Placement Survey 2002 (1.)</strong></p> <ul> <li><a href=\"https://content.usi.ch/sites/default/files/storage/attachments/alumni/alumni-sintesi-risultati-2002.pdf\">Ergebnisse 2002</a></li> </ul>"}],"ctas":[],"nav":[{"label":"Alumni","href":"/en/university/info/alumni"},{"label":"Mein Alumni-Profil","href":"/en/university/info/alumni/my-alumni/profile"},{"label":"Meine Karrieregeschichte","href":"/en/university/info/alumni/my-alumni/my-career-story"},{"label":"Vorteile","href":"/en/university/info/alumni/my-alumni/benefits"},{"label":"Mein Chapter","href":"/en/originalnode/8951"},{"label":"Alumni-Kalender","href":"/en/university/info/alumni/events/alumni-calendar"},{"label":"Alumni Talks","href":"/en/university/info/alumni/meet-the-alumni/digital-talks"},{"label":"Visiting Alumni","href":"/en/university/info/alumni/meet-the-alumni/visiting-alumni"},{"label":"Chapter-Treffen","href":"/en/university/info/alumni/meet-the-alumni/chapter-meetings"},{"label":"Ehemaligentreffen","href":"/en/university/info/alumni/meet-the-alumni/reunions"},{"label":"Zahlen und Fakten","href":"/en/university/info/alumni/portraits/usi-graduates"},{"label":"USI Career Stories","href":"/en/university/info/alumni/portraits/career-stories"},{"label":"USI Alumni Mentors","href":"/en/university/info/alumni/portraits/usi-alumni-mentors"},{"label":"Absolvierendenbefragung","href":"/en/university/info/alumni/portraits/survey"},{"label":"Chapters","href":"/en/university/info/alumni/network/chapters"},{"label":"Executive Alumni","href":"/en/university/info/alumni/network/executive-alumni"},{"label":"Master-Gruppen","href":"/en/university/info/alumni/network/master-groups"},{"label":"AMA","href":"/en/universita/info/alumni/network/ama"},{"label":"Karrierekalende