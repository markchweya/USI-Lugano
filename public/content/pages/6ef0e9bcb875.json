ita/info/relint/relazioni-internazionali/partenariati"},{"label":"Rapporto annuale","href":"/it/universita/info/relint/rapporto-annuale"},{"label":"Dati statistici","href":"/it/universita/info/relint/mobilita/cifre"},{"label":"Tutte le categorie","href":"/it/universita/info/relint/informazioni-specifiche"},{"label":"Studenti/esse USI","href":"/it/universita/info/relint/studente-usi"},{"label":"Mobilità in entrata","href":"/it/universita/info/relint/informazioni-specifiche/studenti-mobilita-in-entrata"},{"label":"Stages in entrata","href":"/it/universita/info/relint/informazioni-specifiche/stagisti-in-entrata"},{"label":"InclUSIone","href":"/it/universita/info/relint/inclusione"},{"label":"Borsisti/e ESKAS","href":"/it/universita/info/relint/informazioni-specifiche/borse-eccellenza-confederazione-svizzera"},{"label":"Scholars at Risk","href":"/it/universita/info/relint/informazioni-specifiche/scholars-at-risk-network"},{"label":"Corpo accademico USI","href":"/it/universita/info/relint/informazioni-specifiche/corpo-accademico"},{"label":"Staff USI","href":"/it/universita/info/relint/informazioni-specifiche/personale-amministrativo"},{"label":"Corpo accademico in entrata","href":"/it/universita/info/relint/informazioni-specifiche/corpo-accademico-in-mobilita-all-usi"},{"label":"Staff in entrata","href":"/it/universita/info/relint/informazioni-specifiche/staff-in-entrata"},{"label":"Visiting researchers","href":"/it/universita/info/relint/informazioni-specifiche/ricercatori-in-visita"},{"label":"Enti esterni","href":"/it/universita/info/relint/informazioni-specifiche/enti-esterni"},{"label":"Università partner","href":"/it/universita/info/relint/informazioni-specifiche/universita-partner"},{"label":"Università interessate","href":"/it/universita/info/relint/informazioni-specifiche/universita-interessate"},{"label":"Internazionalizzazione a casa - I@H","href":"/it/universita/info/relint/internationalization-at-home"},{"label":"Newsletter \"Come and Go\"","href":"/it/univ