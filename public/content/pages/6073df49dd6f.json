mation/universita-partner"},{"label":"Interessierte Universitäten","href":"/en/university/info/relint/specific-information/universities-interested"},{"label":"Internationalisation at home – I@H","href":"/en/university/info/relint/specific-information/internationalization-at-home"},{"label":"Newsletter «Come and Go»","href":"/en/university/info/relint/come-go-archive"},{"label":"Veranstaltungen","href":"/en/university/info/relint/events"},{"label":"Il mondo in USI","href":"/en/university/info/relint/il-mondo-in-usi"},{"label":"News","href":"/en/university/info/relint/news"},{"label":"Team und Kontakte","href":"/en/university/info/relint/team"},{"label":"2005–2025: 20 Jahre Tätigkeit","href":"/en/university/info/relint/20-years-of-activity"}],"links":[{"label":"+41 58 666 4626","href":"tel:+41586664626"},{"label":"relint@usi.ch","href":"mailto:relint@usi.ch"},{"label":"+41 58 666 5803","href":"tel:+41586665803"},{"label":"Anfrageformular für Besuche/Delegationen (PDF 100.83 KB)","href":"/sites/default/files/storage/attachments/relint-request_form_for_a_visit.pdf"}],"source":"https://www.usi.ch/en/university/info/relint/specific-information/universita-partner","fetchedAt":"2026-10-08T17:58:23.584Z","translated":true}